<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Underworld Game — Official Site</title>
  <style>
    /* Global Reset */
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: Arial, sans-serif; background: #0a0a0a; color: #fff; line-height: 1.6; }
    a { text-decoration: none; color: #ff4444; }

    /* Header */
    header {
      background: url('https://picsum.photos/1920/800?blur=2') no-repeat center/cover;
      height: 100vh;
      display: flex; flex-direction: column; justify-content: center; align-items: center;
      text-align: center; padding: 20px;
    }
    header h1 { font-size: 4rem; color: #ff0000; text-shadow: 2px 2px 10px black; }
    header p { font-size: 1.3rem; margin: 20px 0; }
    header button {
      padding: 12px 25px; font-size: 1.2rem;
      background: #ff0000; border: none; border-radius: 5px;
      cursor: pointer; transition: 0.3s;
    }
    header button:hover { background: #ff4444; }

    /* Section Styling */
    section { padding: 60px 20px; max-width: 1200px; margin: auto; }
    h2 { font-size: 2.5rem; margin-bottom: 20px; text-align: center; color: #ff4444; }

    /* Zones Grid */
    .zones {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px;
    }
    .zone-card {
      background: #111; padding: 20px; border-radius: 10px;
      transition: 0.3s; border: 1px solid #333;
    }
    .zone-card:hover { transform: scale(1.05); border-color: #ff4444; }
    .zone-card h3 { margin-bottom: 10px; color: #ff0000; }

    /* Table */
    table { width: 100%; border-collapse: collapse; margin-top: 20px; }
    table, th, td { border: 1px solid #333; }
    th, td { padding: 10px; text-align: center; }
    th { background: #222; color: #ff4444; }

    /* Gameplay Steps */
    .steps { list-style: none; margin-top: 20px; }
    .steps li { padding: 10px; margin-bottom: 10px; background: #111; border-left: 5px solid #ff4444; }

    /* Coming Soon */
    .coming-soon {
      text-align: center;
      background: linear-gradient(135deg, #111, #222);
      padding: 80px 20px;
      margin-top: 50px;
      border-radius: 10px;
      border: 2px dashed #ff4444;
    }
    .coming-soon h2 {
      font-size: 3rem;
      color: #ff0000;
      text-shadow: 0 0 15px #ff4444;
      animation: flicker 1.5s infinite alternate;
    }
    .coming-soon p {
      margin-top: 15px;
      font-size: 1.2rem;
      color: #ccc;
    }

    @keyframes flicker {
      from { opacity: 1; }
      to { opacity: 0.6; }
    }

    /* Footer */
    footer { background: #111; padding: 20px; text-align: center; margin-top: 50px; border-top: 1px solid #333; }
  </style>
</head>
<body>

  <!-- Hero Banner -->
  <header>
    <h1>UNDERWORLD</h1>
    <p>Escape the darkness, fight the monsters, unlock the Mega Gate. 🔑🔥</p>
    <button onclick="scrollToContent()">Explore the Game</button>
  </header>

  <!-- Game Lore -->
  <section>
    <h2>Game Story</h2>
    <p>
      Welcome to <b>Underworld</b>, a realm of danger and mystery. Explore frozen wastelands, fiery volcanoes, and radioactive ruins.
      Rescue NPCs, defeat terrifying monsters, and gather 5 keys from each zone to unlock the <b>Mega Gate</b> and escape!
    </p>
  </section>

  <!-- Zones -->
  <section>
    <h2>Zones</h2>
    <div class="zones">
      <div class="zone-card"><h3>❄ Frossbite</h3><p>Bippy, Kimpdses, Headso</p></div>
      <div class="zone-card"><h3>🌋 Fireball</h3><p>Surprising Monster, Galactopus, Jam Jam</p></div>
      <div class="zone-card"><h3>☢ Nuclear Zone</h3><p>Meowser, Milan the Villain</p></div>
      <div class="zone-card"><h3>🏰 Safe Zone</h3><p>Protected by King Milan</p></div>
      <div class="zone-card"><h3>🛒 Market</h3><p>Upgrades, potions, weapons</p></div>
      <div class="zone-card"><h3>🏋 Training Zone</h3><p>Practice & train freely</p></div>
      <div class="zone-card"><h3>🌀 Static Zone</h3><p>Final Boss: The BCob</p></div>
      <div class="zone-card"><h3>🔥 H3ll</h3><p>Nelson - Survivor NPC</p></div>
    </div>
  </section>

  <!-- Monsters -->
  <section>
    <h2>Monsters & NPCs</h2>
    <table>
      <tr><th>Name</th><th>Power</th><th>Health</th><th>Notes</th></tr>
      <tr><td>Bippy</td><td>10</td><td>30</td><td>Weak to light</td></tr>
      <tr><td>Surprising Monster</td><td>?</td><td>?</td><td>Stats revealed in fight</td></tr>
      <tr><td>Headso</td><td>55</td><td>100</td><td>Freezes if looked at</td></tr>
      <tr><td>Kimpdses</td><td>90</td><td>0.1</td><td>Kill from behind</td></tr>
      <tr><td>Milan the Villain</td><td>∞</td><td>100</td><td>Deadly touch</td></tr>
      <tr><td>Meowser</td><td>105</td><td>95</td><td>Cat Scratch attack</td></tr>
      <tr><td>Galactopus</td><td>120</td><td>110</td><td>Poison squish (165 dmg)</td></tr>
      <tr><td>Jam Jam</td><td>100</td><td>1000</td><td>Weak to nose hit</td></tr>
      <tr><td>The BCob</td><td>∞</td><td>∞</td><td>Kill central eye</td></tr>
    </table>
  </section>

  <!-- Gameplay Loop -->
  <section>
    <h2>Gameplay Loop</h2>
    <ul class="steps">
      <li>Start in Safe Zone 🏰 → tutorial explains zones</li>
      <li>Explore zones → fight monsters → collect keys</li>
      <li>Earn gold & health regen for kills</li>
      <li>If you die → respawn in Market 🛒</li>
      <li>Meet Nelson in H3ll 🔥 → get power boost</li>
      <li>Defeat bosses: Jam Jam, Milan the Villain, The BCob</li>
      <li>Escape through the Mega Gate 🚪✨</li>
    </ul>
  </section>

  <!-- Features -->
  <section>
    <h2>Special Features</h2>
    <p>✔ Teleporters in every zone<br>
       ✔ Training Zone for practice<br>
       ✔ Safe Zone with protector NPC<br>
       ✔ Market hub for upgrades & respawn
    </p>
  </section>

  <!-- Coming Soon -->
  <section class="coming-soon">
    <h2>🚨 COMING SOON 🚨</h2>
    <p>Prepare yourself, warrior... The Underworld awaits. 🔑🔥</p>
  </section>

  <!-- Footer -->
  <footer>
    <p>© 2025 Underworld Game. All rights reserved.</p>
    <p>Follow us: <a href="#">Twitter</a> | <a href="#">Discord</a></p>
  </footer>

  <script>
    function scrollToContent() {
      window.scrollTo({ top: window.innerHeight, behavior: 'smooth' });
    }
  </script>
</body>
</html>
